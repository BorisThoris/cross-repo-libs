{
  "name": "cross-repo-libs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Personal monorepo for reusable packages (notifications, runtime utils, hooks, …)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "components:scan": "node scripts/scan-components.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "example:dev": "npm run dev --workspace=example-web",
    "storybook:dev": "npm run example:dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}

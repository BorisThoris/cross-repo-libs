{
  "name": "@cross-repo-libs/three-primitives",
  "version": "0.1.0",
  "description": "Portable React Three Fiber primitives extracted and refined from local 3D/game repos.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.170"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.3.0",
    "@types/three": "^0.180.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.180.0"
  }
}
